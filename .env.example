DATABASE_URL=postgresql+asyncpg://daad:daad@localhost:5432/daad
# Database used by `pytest -m integration`. Defaults to DATABASE_URL with the
# database name suffixed `_test` (here: daad_test) so tests never touch real
# ingested data. Create it once with:
#   docker compose exec postgres psql -U daad -d postgres -c "CREATE DATABASE daad_test"
TEST_DATABASE_URL=postgresql+asyncpg://daad:daad@localhost:5432/daad_test
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=programs
# Qdrant collection used by integration tests (created and dropped per test).
TEST_COLLECTION_NAME=programs_test
VOYAGE_API_KEY=replace-with-your-voyage-api-key
# "voyage" or "local" (default here). A cardless Voyage free-tier key is
# capped at 3 requests/minute AND 10K tokens/minute — a single 100-program
# batch alone can exceed the token cap, so embedding a full catalog isn't
# practical without adding billing. "local" runs BAAI/bge-large-en-v1.5
# on-device via sentence-transformers instead: no API key, no rate limit, no
# cost, ever (first use downloads the model, a few GB, then it's fully
# offline) -- the default for this project since no paid Voyage key is
# provisioned.
# Voyage and local vectors are NOT interchangeable — if you switch providers
# on a collection that already has vectors from the other one, re-embed
# everything (delete and recreate the Qdrant collection first).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# Required by `extract` (eligibility extraction via Groq-hosted
# llama-3.3-70b-versatile). Get a free key at https://console.groq.com/keys.
# The free tier has a daily request quota — use `extract --limit N` to cap a
# run, then re-run `extract` later to resume where it stopped.
GROQ_API_KEY=replace-with-your-groq-api-key
# Origins allowed to call the API cross-origin. Vite's default dev port is
# 5173. Defaults to ["http://localhost:5173"] if unset.
# CORS_ALLOWED_ORIGINS=["http://localhost:5173"]  # JSON list, not comma-separated
DAAD_BASE_URL=https://www2.daad.de/deutschland/studienangebote/international-programmes
HTTP_USER_AGENT=daad-search-portfolio-project/0.1 (contact: you@example.com)
REQUEST_DELAY_SECONDS=0.3
MAX_CONCURRENCY=5
CACHE_DIR=.cache/daad
# Cached DAAD responses older than this are re-fetched (default: 1 day).
# Set to 0 to disable cache reads entirely; `ingest --refresh` does it per run.
CACHE_TTL_SECONDS=86400
